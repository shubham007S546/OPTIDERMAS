# ==========================================
# OptiDerma Environment Configuration
# ==========================================

# Base URL for the Skin Lesion Inference Backend (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ElevenLabs Conversational Voice Assistant (Public Agent ID for Browser SDK)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_6601m418gdvxe7zr1zksvnmtb3f1

# Server-Only ElevenLabs API Credentials (Optional for Signed URLs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=agent_6601m418gdvxe7zr1zksvnmtb3f1

# Supabase Project Configuration (Optional: fallback in-memory booking active if unreachable)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PROJECT_REF=your_project_ref

# Backend Model & Service Configuration
OPTIDERMA_MODEL_PATH=model/optiderma_best_model.pth
GROQ_API_KEY=your_optional_groq_api_key_here
