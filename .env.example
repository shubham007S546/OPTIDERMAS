# ==========================================
# OptiDerma Environment Configuration
# ==========================================

# Base URL for the Skin Lesion Inference Backend (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Native Voice Assistant (Zero Subscription Required)
# OptiDerma uses the browser Web Speech API and backend Whisper STT. No external voice subscription needed.

# Supabase Project Configuration (Optional: fallback in-memory & local SQLite WAL active if unreachable)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PROJECT_REF=your_project_ref

# Backend Model & Service Configuration
OPTIDERMA_MODEL_PATH=model/optiderma_best_model.pth
GROQ_API_KEY=your_groq_api_key_here
