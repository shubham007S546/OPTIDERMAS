# OptiDerma Backend Configuration
PROJECT_NAME="OptiDerma API"
ENVIRONMENT="development"
DEBUG=True

# API Host Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# LLM & STT API Keys
GROQ_API_KEY=""

# Voice Synthesis API Keys (ElevenLabs)
